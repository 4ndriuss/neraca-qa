# Data mentah (PDF laporan keuangan) tidak di-commit karena ukurannya besar.
# Struktur folder tetap tersimpan lewat .gitkeep.
data/raw/*
!data/raw/.gitkeep

# Hasil olahan bisa dibuat ulang dari data/raw (lihat README).
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
